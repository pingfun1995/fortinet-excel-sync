  "sync": {
    "poll_interval_seconds": 5,
    "delay_between_commands_seconds": 3,
    "delete_removed_objects": true
  },
  "state_file": "sync_state.json",
  "report_file": "reports/sync_report.xlsx",
  "log_file": "fortinet_sync.log"
